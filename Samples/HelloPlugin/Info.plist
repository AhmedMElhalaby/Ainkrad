<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>com.ainkrad.plugin.hello</string>
    <key>CFBundleName</key><string>HelloPlugin</string>
    <!-- Required: the host installer renames an installed bundle to
         <appID>.bundle, so CFBundle's filename-based executable fallback would
         miss the real executable. Every plugin must declare this explicitly. -->
    <key>CFBundleExecutable</key><string>HelloPlugin</string>
    <key>CFBundlePackageType</key><string>BNDL</string>
    <key>NSPrincipalClass</key><string>HelloEntryPoint</string>
    <key>AinkradAppID</key><string>hello</string>
    <key>AinkradDisplayName</key><string>Hello</string>
    <key>AinkradIconSymbol</key><string>hand.wave</string>
    <key>AinkradAPIVersion</key><integer>7</integer>
    <key>AinkradAuthor</key><string>Ainkrad</string>
    <key>description</key><string>A minimal sample plugin demonstrating the Ainkrad plugin contract.</string>
</dict>
</plist>
